# зависимости
node_modules/

# сборка приложения для телефона
# www/ и android/ — то, что собирается из исходников: первое собирает
# tools/www.mjs, второе — Capacitor. В репозитории им делать нечего:
# сотни сгенерированных файлов, которые устаревают молча
www/
android/
out/

# служебное
*.log
.DS_Store
Thumbs.db

# личные бэкапы задач
*.backup.json

# снимки и профиль браузера от стенда tools/
tools/out/

# ключ подписи — никогда и ни под каким видом
# репозиторий публичный: попав сюда, ключ перестанет быть секретом,
# а вместе с ним и подпись приложения
*.jks
*.p12
*.keystore
keystore.b64
